{
  "datasets": [
    {
      "name": "ds_genre_dist",
      "displayName": "Distribucion de Generos Top 10",
      "queryLines": [
        "SELECT\n",
        "  genre,\n",
        "  book_count\n",
        "FROM\n",
        "  catalog_au.golden.genre_distribution_synced\n",
        "ORDER BY\n",
        "  book_count DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_top_genre",
      "displayName": "KPI - Genero Popular",
      "queryLines": [
        "SELECT\n",
        "  genre,\n",
        "  book_count\n",
        "FROM\n",
        "  catalog_au.golden.genre_distribution_synced\n",
        "ORDER BY\n",
        "  book_count DESC\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "ds_top_authors",
      "displayName": "Top 10 Autores por Bestsellers",
      "queryLines": [
        "SELECT\n",
        "  author,\n",
        "  total_bestseller_books\n",
        "FROM\n",
        "  catalog_au.golden.top_authors_synced\n",
        "ORDER BY\n",
        "  total_bestseller_books DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_top_books",
      "displayName": "Top 10 Libros por Anos Bestseller",
      "queryLines": [
        "SELECT\n",
        "  name,\n",
        "  years_as_bestseller\n",
        "FROM\n",
        "  catalog_au.golden.top_books_synced\n",
        "ORDER BY\n",
        "  years_as_bestseller DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_kpi_authors",
      "displayName": "KPI - Total Autores",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_authors\n",
        "FROM\n",
        "  catalog_au.golden.top_authors_synced"
      ]
    },
    {
      "name": "ds_kpi_books",
      "displayName": "KPI - Total Libros",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_books\n",
        "FROM\n",
        "  catalog_au.golden.top_books_synced"
      ]
    },
    {
      "name": "ds_country_reading",
      "displayName": "Indice de Lectura por Pais",
      "queryLines": [
        "SELECT\n",
        "  country,\n",
        "  reading_index\n",
        "FROM\n",
        "  catalog_au.golden.country_reading_synced\n",
        "ORDER BY\n",
        "  reading_index DESC"
      ]
    },
    {
      "name": "ds_books_by_genre",
      "displayName": "Top 5 Libros por Genero",
      "queryLines": [
        "SELECT\n",
        "  genre,\n",
        "  rank,\n",
        "  title,\n",
        "  author,\n",
        "  rating\n",
        "FROM\n",
        "  catalog_au.golden.top_books_by_genre_synced\n",
        "WHERE\n",
        "  rank <= 5\n",
        "ORDER BY\n",
        "  genre,\n",
        "  rank"
      ]
    }
  ],
